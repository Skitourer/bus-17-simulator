{
  "name": "bus-17-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Bus-driving game in the browser on the real route of Grenoble bus line 17.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "@vitest/coverage-v8": "5.1.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
